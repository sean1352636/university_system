{
  "template_id": "calendar_report",
  "category": "academics",
  "name": "Academic Calendar Report",
  "description": "Email template for sending calendar reports to administrators",
  "version": "1.0.0",
  "subject": "Calendar Report: {report_title}",
  "body_text": "Academic Calendar Report\n\nReport: {report_title}\nGenerated: {generated_at}\n\n{separator}\n\n{report_content}\n\n{separator}\n\nThis report was generated by the Academic Calendar System.",
  "body_html": "<!DOCTYPE html><html lang=\"en\"><head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta charset=\"UTF-8\"><title>{report_title}</title></head><body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 20px;\"><div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin-bottom: 20px;\"><h2 style=\"margin: 0; color: #007bff;\">Academic Calendar Report</h2></div><div style=\"background-color: #fff; padding: 20px; border: 1px solid #dee2e6; border-radius: 5px;\"><p><strong>Report:</strong> {report_title}</p><p><strong>Generated:</strong> {generated_at}</p><hr style=\"border: none; border-top: 1px solid #dee2e6; margin: 20px 0;\"><div style=\"white-space: pre-wrap; font-family: 'Courier New', monospace; background-color: #f8f9fa; padding: 15px; border-radius: 5px;\">{report_content}</div><hr style=\"border: none; border-top: 1px solid #dee2e6; margin: 20px 0;\"><p style=\"color: #6c757d; font-size: 0.9em;\">This report was generated by the Academic Calendar System.</p></div></body></html>",
  "variables": {
    "report_title": {
      "type": "string",
      "required": true,
      "description": "Title of the calendar report"
    },
    "generated_at": {
      "type": "string",
      "required": true,
      "description": "Timestamp when the report was generated"
    },
    "report_content": {
      "type": "string",
      "required": true,
      "description": "The full content of the report"
    },
    "separator": {
      "type": "string",
      "required": false,
      "default": "--------------------------------------------------",
      "description": "Visual separator line"
    }
  },
  "tags": [
    "academics",
    "calendar",
    "report",
    "admin"
  ],
  "created_at": "2026-01-29T00:00:00Z",
  "updated_at": "2026-01-29T00:00:00Z"
}
