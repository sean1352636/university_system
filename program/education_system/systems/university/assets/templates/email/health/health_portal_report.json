{
  "template_id": "health_portal_report",
  "category": "health",
  "name": "Health Portal Report",
  "description": "Health portal report sent to administrators",
  "version": "1.0.0",
  "subject": "Health Portal - {report_type} - {user_name}",
  "body_text": "Health Portal Report\n\nReport Type: {report_type}\nStudent: {user_name} (ID: {user_id})\nGenerated: {generated_at}\n\n{separator}\n\n{report_content}\n\n{separator}\n\nThis report was automatically generated and sent from the Health Portal system.",
  "body_html": "<!DOCTYPE html><html lang=\"en\"><head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta charset=\"UTF-8\"><title>{report_type}</title></head><body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 20px;\"><div style=\"background-color: #17a2b8; color: white; padding: 15px; border-radius: 5px 5px 0 0;\"><h2 style=\"color: #ffffff; margin: 0;\">&#127973; Health Portal Report</h2></div><div style=\"background-color: #fff; padding: 20px; border: 1px solid #dee2e6; border-top: none; border-radius: 0 0 5px 5px;\"><div style=\"background-color: #d1ecf1; padding: 15px; border-radius: 5px; margin-bottom: 20px;\"><p style=\"margin: 5px 0;\"><strong>Report Type:</strong> {report_type}</p><p style=\"margin: 5px 0;\"><strong>Student:</strong> {user_name} (ID: {user_id})</p><p style=\"margin: 5px 0;\"><strong>Generated:</strong> {generated_at}</p></div><div style=\"background-color: #f8f9fa; padding: 20px; border-radius: 5px; margin: 20px 0; white-space: pre-wrap; font-family: monospace;\">{report_content}</div><p style=\"color: #6c757d; font-size: 14px; margin-top: 30px; text-align: center;\">This report was automatically generated and sent from the Health Portal system.</p></div></body></html>",
  "variables": {
    "report_type": {
      "type": "string",
      "required": true,
      "description": "Type of health report"
    },
    "user_name": {
      "type": "string",
      "required": true,
      "description": "Student/user name"
    },
    "user_id": {
      "type": "string",
      "required": true,
      "description": "Student/user ID"
    },
    "generated_at": {
      "type": "string",
      "required": true,
      "description": "Timestamp when generated"
    },
    "report_content": {
      "type": "string",
      "required": true,
      "description": "Full report content"
    },
    "separator": {
      "type": "string",
      "required": false,
      "default": "============================================================",
      "description": "Visual separator line for the text version"
    }
  },
  "tags": [
    "health",
    "report",
    "admin",
    "confidential"
  ],
  "created_at": "2026-01-29T00:00:00Z",
  "updated_at": "2026-07-26T00:00:00Z"
}
