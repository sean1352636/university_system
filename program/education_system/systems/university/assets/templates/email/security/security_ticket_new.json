{
  "template_id": "security_ticket_new",
  "category": "security",
  "name": "New Security Ticket",
  "description": "Email sent to admins when a new security ticket is submitted",
  "version": "1.0.0",
  "subject": "New Security Ticket: {ticket_id} - {ticket_type}",
  "body_text": "A new security request has been submitted.\n\nTicket ID: {ticket_id}\nType: {ticket_type}\nPriority: {priority}\nRequester: {requester_name}\nCreated: {created_at}\n\nDetails: {details}\n\nPlease log in to the Security Desk to review and respond to this ticket.",
  "body_html": "<!DOCTYPE html><html lang=\"en\"><head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta charset=\"UTF-8\"><title>New Security Ticket</title></head><body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;\"><div style=\"background-color: #fd7e14; color: white; padding: 15px; border-radius: 5px 5px 0 0;\"><h2 style=\"color: #ffffff; margin: 0;\">&#128272; New Security Ticket</h2></div><div style=\"background-color: #fff; padding: 20px; border: 1px solid #dee2e6; border-top: none; border-radius: 0 0 5px 5px;\"><p><strong>A new security request has been submitted.</strong></p><div style=\"background-color: #ffe8cc; padding: 15px; border-left: 4px solid #fd7e14; margin: 20px 0;\"><p style=\"margin: 5px 0;\"><strong>Ticket ID:</strong> {ticket_id}</p><p style=\"margin: 5px 0;\"><strong>Type:</strong> {ticket_type}</p><p style=\"margin: 5px 0;\"><strong>Priority:</strong> {priority}</p><p style=\"margin: 5px 0;\"><strong>Requester:</strong> {requester_name}</p><p style=\"margin: 5px 0;\"><strong>Created:</strong> {created_at}</p></div><div style=\"background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin: 20px 0;\"><p style=\"margin: 0 0 10px 0; font-weight: bold;\">Details:</p><p style=\"margin: 0;\">{details}</p></div><p><strong>Please log in to the Security Desk to review and respond to this ticket.</strong></p></div></body></html>",
  "variables": {
    "ticket_id": {
      "type": "string",
      "required": true,
      "description": "Security ticket ID"
    },
    "ticket_type": {
      "type": "string",
      "required": true,
      "description": "Type of security ticket"
    },
    "priority": {
      "type": "string",
      "required": true,
      "description": "Ticket priority level"
    },
    "requester_name": {
      "type": "string",
      "required": true,
      "description": "Name of person requesting help"
    },
    "created_at": {
      "type": "string",
      "required": true,
      "description": "Ticket creation timestamp"
    },
    "details": {
      "type": "string",
      "required": false,
      "default": "No additional details",
      "description": "Additional ticket details"
    }
  },
  "tags": [
    "security",
    "ticket",
    "new",
    "notification",
    "admin"
  ],
  "created_at": "2026-01-29T00:00:00Z",
  "updated_at": "2026-01-29T00:00:00Z"
}
