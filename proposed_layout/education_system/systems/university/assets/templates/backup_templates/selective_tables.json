{
  "name": "Selective Tables Backup",
  "description": "Backup only specific critical tables",
  "backup_type": "full",
  "scheduled_backup_time": "04:00",
  "backup_frequency": "daily",
  "max_backups": 10,
  "auto_backup_enabled": true,
  "compression_enabled": true,
  "compression_format": "gzip",
  "compression_level": 6,
  "encryption_enabled": false,
  "encryption_password": "",
  "secure_deletion": false,
  "verify_integrity": true,
  "cloud_enabled": false,
  "remote_enabled": false,
  "email_notifications": false,
  "enable_incremental": false,
  "enable_selective": true,
  "selective_tables": [
    "students",
    "courses",
    "enrollments",
    "grades",
    "users"
  ],
  "enable_deduplication": false,
  "parallel_backup": false,
  "max_threads": 2,
  "bandwidth_limit_mbps": 0,
  "retention_policy": {
    "daily_keep": 10,
    "weekly_keep": 5,
    "monthly_keep": 12,
    "yearly_keep": 5
  }
}
