{
  "name": "AWS Cloud Backup",
  "description": "Backup with AWS S3 cloud storage integration",
  "backup_type": "full",
  "scheduled_backup_time": "01:00",
  "backup_frequency": "daily",
  "max_backups": 15,
  "auto_backup_enabled": true,
  "compression_enabled": true,
  "compression_format": "gzip",
  "compression_level": 9,
  "encryption_enabled": true,
  "encryption_password": "",
  "secure_deletion": false,
  "verify_integrity": true,
  "cloud_enabled": true,
  "cloud_provider": "aws",
  "aws_bucket": "",
  "aws_access_key": "",
  "aws_secret_key": "",
  "aws_region": "us-east-1",
  "remote_enabled": false,
  "email_notifications": true,
  "smtp_server": "smtp.gmail.com",
  "smtp_port": 587,
  "email_username": "",
  "email_password": "",
  "notification_recipients": [],
  "enable_incremental": false,
  "enable_selective": false,
  "selective_tables": [],
  "enable_deduplication": true,
  "parallel_backup": true,
  "max_threads": 4,
  "bandwidth_limit_mbps": 50,
  "storage_quota_gb": 50,
  "retention_policy": {
    "daily_keep": 7,
    "weekly_keep": 4,
    "monthly_keep": 12,
    "yearly_keep": 7
  }
}
