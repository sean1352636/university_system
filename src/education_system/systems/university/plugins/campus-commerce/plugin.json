{
  "schemaVersion": 1,
  "id": "campus-commerce",
  "version": "1.0.0",
  "platform": {"minimum": "9.7.0", "maximumExclusive": "10.0.0"},
  "capabilities": [
    "campus.betting", "campus.butcher", "campus.bakery",
    "campus.nailbar", "campus.car-rental"
  ],
  "routes": [
    "education_system.platform.delivery.api.university.routes.betting_routes:betting_bp",
    "education_system.platform.delivery.api.university.routes.butcher_routes:butcher_bp",
    "education_system.platform.delivery.api.university.routes.nailbar_routes:nailbar_bp",
    "education_system.platform.delivery.api.university.routes.carrental_routes:carrental_bp"
  ],
  "optionalDependencies": ["education-system[commerce]"],
  "permissions": ["plugin.campus-commerce.use", "plugin.campus-commerce.admin"],
  "dataClassifications": ["personal", "confidential"],
  "canonicalWrites": [],
  "support": "demo",
  "retention": "Transactions: 7 years; preferences: account lifetime plus 90 days",
  "healthCheck": "plugin database and payment-adapter connectivity",
  "uninstall": "Export financial records, revoke routes, retain ledger read-only"
}
