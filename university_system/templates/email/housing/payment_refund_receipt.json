      "required": true,
      "description": "Refund amount"
    },
    "method": {
      "type": "string",
      "required": true,
      "description": "Refund method"
    },
    "refund_date": {
      "type": "string",
      "required": true,
      "description": "Date of refund"
    }
  },
  "tags": ["housing", "payment", "refund", "receipt"],
