{
  "template_id": "housing_payment_refund_receipt",
  "category": "housing",
  "name": "Housing Payment Refund Receipt",
  "description": "Receipt email sent when housing payment is refunded",
  "version": "1.0.0",
  "subject": "Housing Payment Refund Receipt",
  "body_text": "Dear Student,\n\nYour housing payment refund has been processed successfully.\n\nREFUND RECEIPT\n==============\nPayment ID: {payment_id}\nStudent ID: {student_id}\nRefund Amount: £{amount}\nRefund Method: {method}\nDate: {refund_date}\n\nIf you have any questions about this refund, please contact the Housing Office.\n\nBest regards,\nUniversity Housing Department",
  "body_html": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>Refund Receipt</title></head><body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;\"><div style=\"background-color: #28a745; color: white; padding: 15px; border-radius: 5px 5px 0 0;\"><h2 style=\"margin: 0;\">💰 Housing Payment Refund Receipt</h2></div><div style=\"background-color: #fff; padding: 20px; border: 1px solid #dee2e6; border-top: none; border-radius: 0 0 5px 5px;\"><p>Dear Student,</p><p><strong>Your housing payment refund has been processed successfully.</strong></p><div style=\"background-color: #d4edda; padding: 20px; border-left: 4px solid #28a745; margin: 20px 0;\"><h3 style=\"margin: 0 0 15px 0; color: #28a745;\">Refund Receipt</h3><table style=\"width: 100%; border-collapse: collapse;\"><tr><td style=\"padding: 8px 0; font-weight: bold; width: 40%;\">Payment ID:</td><td style=\"padding: 8px 0;\">{payment_id}</td></tr><tr><td style=\"padding: 8px 0; font-weight: bold;\">Student ID:</td><td style=\"padding: 8px 0;\">{student_id}</td></tr><tr style=\"background-color: #c3f3d0;\"><td style=\"padding: 12px 8px; font-weight: bold; font-size: 18px;\">Refund Amount:</td><td style=\"padding: 12px 8px; font-size: 18px; color: #28a745; font-weight: bold;\">£{amount}</td></tr><tr><td style=\"padding: 8px 0; font-weight: bold;\">Refund Method:</td><td style=\"padding: 8px 0;\">{method}</td></tr><tr><td style=\"padding: 8px 0; font-weight: bold;\">Date:</td><td style=\"padding: 8px 0;\">{refund_date}</td></tr></table></div><p>If you have any questions about this refund, please contact the Housing Office.</p><p style=\"margin-top: 30px;\">Best regards,<br><strong>University Housing Department</strong></p></div></body></html>",
  "variables": {
    "payment_id": {
      "type": "string",
      "required": true,
      "description": "Payment ID"
    },
    "student_id": {
      "type": "string",
      "required": true,
