# ============================================================================
# University System Environment Variables
# ============================================================================
#
# SECURITY WARNING: This is an EXAMPLE file showing required environment variables.
# DO NOT commit real credentials to version control!
#
# To use:
# 1. Copy this file to .env in the same directory
# 2. Replace all dummy values with your actual credentials
# 3. Ensure .env is in your .gitignore file
# 4. Never commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Currency Exchange API Configuration
# ----------------------------------------------------------------------------
# API key for currency exchange rate services
# Used in: finance modules for currency conversion
# Get your API key from: https://exchangeratesapi.io/ or similar service
EXCHANGE_API_KEY=your_exchange_api_key_here

# ----------------------------------------------------------------------------
# Demo/Test User Credentials
# ----------------------------------------------------------------------------
# WARNING: These are for DEMO/TESTING purposes only!
# In production, disable demo accounts or use strong, unique passwords
# Change these immediately in any production deployment

# Default admin user password (used when creating initial admin account)
DEFAULT_ADMIN_PASSWORD=admin123

# Default staff user password (used in demo/test environments)
DEFAULT_STAFF_PASSWORD=staff123

# Default student user password (used in demo/test environments)
DEFAULT_STUDENT_PASSWORD=student123

# Shop management GUI demo passwords
DEMO_ADMIN_PASSWORD=admin
DEMO_STAFF_PASSWORD=password
DEMO_STUDENT_PASSWORD=password

# ----------------------------------------------------------------------------
# Payment Gateway Configuration (Optional)
# ----------------------------------------------------------------------------
# Stripe API Keys (if using Stripe for payments)
# STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal API Keys (if using PayPal for payments)
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_ENVIRONMENT=sandbox  # Use 'live' for production

# ----------------------------------------------------------------------------
# Database Configuration (Optional - if using external databases)
# ----------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=university_system
# DB_USER=db_user
# DB_PASSWORD=secure_database_password

# ----------------------------------------------------------------------------
# Email/SMTP Configuration (Optional)
# ----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_USE_TLS=True

# ----------------------------------------------------------------------------
# JWT/Session Security (Optional)
# ----------------------------------------------------------------------------
# JWT_SECRET_KEY=generate_a_random_secret_key_here
# SESSION_SECRET=another_random_secret_for_sessions

# ----------------------------------------------------------------------------
# Application Environment
# ----------------------------------------------------------------------------
# APP_ENV=development  # Options: development, staging, production
# DEBUG=True           # Set to False in production
# LOG_LEVEL=INFO       # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ----------------------------------------------------------------------------
# Additional API Keys (Add as needed)
# ----------------------------------------------------------------------------
# SMS_API_KEY=your_sms_service_api_key
# CLOUD_STORAGE_KEY=your_cloud_storage_api_key
# ANALYTICS_API_KEY=your_analytics_api_key

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# 1. Never commit this file with real values to version control
# 2. Use strong, randomly generated passwords (min 16 characters)
# 3. Rotate credentials regularly (at least every 90 days)
# 4. Use different credentials for dev/staging/production environments
# 5. Store production credentials in secure secret management systems
#    (e.g., AWS Secrets Manager, HashiCorp Vault, Azure Key Vault)
# 6. Limit access to environment variables to only necessary personnel
# 7. Enable two-factor authentication where possible
# 8. Monitor for unauthorized access attempts
# 9. Use environment-specific .env files (.env.development, .env.production)
# 10. Consider using a secrets manager instead of .env files in production
# ============================================================================
