        ttk.Button(button_frame, text="View Details", command=self.view_refund_payment_details).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Export to CSV", command=self.export_refunds_csv).pack(side=tk.LEFT, padx=5)

