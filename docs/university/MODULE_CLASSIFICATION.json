{
  "version": 1,
  "description": "Ordered rules; first match owns every university Python module.",
  "rules": [
    {"glob": "domains/admissions/**", "classification": "core"},
    {"glob": "domains/learners/**", "classification": "core"},
    {"glob": "domains/academics/**", "classification": "core"},
    {"glob": "domains/assessment/**", "classification": "core"},
    {"glob": "domains/finance/**", "classification": "core"},
    {"glob": "domains/safeguarding/**", "classification": "core"},
    {"glob": "domains/pastoral/domain/health/**", "classification": "core"},
    {"glob": "domain/operations/commerce/**", "classification": "demo"},
    {"glob": "domain/operations/campus/community/**", "classification": "optional"},
    {"glob": "infrastructure/ai/**", "classification": "optional"},
    {"glob": "infrastructure/analytics/**", "classification": "optional"},
    {"glob": "interfaces/gui/**", "classification": "optional"},
    {"glob": "services/integrations/**", "classification": "integration"},
    {"glob": "**", "classification": "optional"}
  ]
}
