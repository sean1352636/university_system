# =============================================================================
# Education Management System — example environment configuration
# =============================================================================
# Copy this file to `.env` and adjust the values. `.env` is git-ignored and is
# loaded automatically at startup (python-dotenv). Everything below is a safe
# DEVELOPMENT default; do NOT ship these values to production.
#
# In production (APP_ENV=production / EDU_PRODUCTION=1) the server REFUSES to
# start unless API_SECRET_KEY and JWT_SECRET_KEY are set to strong, persistent
# values. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Environment -------------------------------------------------------------
# development | production. Development enables relaxed defaults and demo seeding.
APP_ENV=development
# Set to 1 to force production behaviour (strict secret enforcement).
EDU_PRODUCTION=0

# --- Core security secrets (REQUIRED in production) --------------------------
# Flask/API signing key and JWT signing key. Leave blank in development to use a
# random per-process key; set persistent values for production.
API_SECRET_KEY=
JWT_SECRET_KEY=
# Optional extra secrets — random per-process fallback in development.
CSRF_SECRET=
API_KEY_PEPPER=
AUDIT_LOG_SECRET=
LOG_HMAC_KEY=
ENCRYPTION_KEY=

# --- JWT / session tuning ----------------------------------------------------
JWT_EXPIRY_HOURS=8
JWT_REFRESH_DAYS=7
EDU_SESSION_TIMEOUT=3600
EDU_MAX_SESSIONS=5

# --- API / web server --------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=0
# Comma-separated list of allowed CORS origins. NEVER use "*" in production.
API_CORS_ORIGINS=http://localhost:8000

# --- Demo data / seeding (development only) ----------------------------------
# Gates seeding of the well-known WEAK demo accounts (admin/admin123 etc.).
# Only when true are they created — even on a fresh database. MUST be
# false/unset in production; a fresh production DB stays empty.
EDU_DEV_SEED=true

# --- Production bootstrap admin ----------------------------------------------
# On a fresh database with EDU_DEV_SEED unset, set BOTH of these to create a
# single admin (access to all five systems) instead of the weak demo accounts.
# The password must be at least 12 characters. Leave unset in development.
# EDU_INITIAL_ADMIN_USER=
# EDU_INITIAL_ADMIN_PASSWORD=
# EDU_INITIAL_ADMIN_EMAIL=

# --- Multi-factor authentication ---------------------------------------------
MFA_ENFORCEMENT_ENABLED=0
MFA_GRACE_PERIOD_DAYS=7
# Comma-separated roles that must enrol in MFA, e.g. superadmin,admin
MFA_REQUIRED_ROLES=
# By default a user who has lost both their password and authenticator may enter
# a single-use MFA recovery code in the password field as a break-glass login
# (rate-limited, single-use, forces a password change). Set to 1 to require the
# explicit /mfa/verify recovery flow instead (strict password/recovery split).
EDU_DISABLE_RECOVERY_CODE_LOGIN=0

# --- Startup / migrations ----------------------------------------------------
# A failed Alembic migration aborts startup by default (fail-closed: don't run
# against an inconsistent schema). Set to 1 to downgrade to a warning — e.g. when
# launching a non-university system, or working against an older dev schema.
EDU_ALLOW_SCHEMA_DRIFT=0

# --- Database ----------------------------------------------------------------
# Central shared auth database (defaults to a path inside the package if unset).
EDU_AUTH_DB=
DB_TIMEOUT=30
DB_BUSY_TIMEOUT=5000
DB_MAX_CONNECTIONS=10
DB_PRAGMA_JOURNAL_MODE=WAL
DB_PRAGMA_SYNCHRONOUS=NORMAL

# --- Logging -----------------------------------------------------------------
# text (interactive) | json (aggregation). LOG_LEVEL: DEBUG|INFO|WARNING|ERROR
LOG_LEVEL=WARNING
LOG_FORMAT=text

# --- Email (SMTP) — optional; delivery is disabled if unset ------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Education System

# =============================================================================
# Optional integrations — leave blank unless the feature is in use. All are
# treated as non-fatal: the related functionality is disabled and logged when
# credentials are missing.
# =============================================================================

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# SMS / voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Chat / alerting
SLACK_BOT_TOKEN=
SECURITY_SLACK_WEBHOOK=
TEAMS_WEBHOOK_URL=

# Cloud storage / KMS (only needed for the relevant cloud extra)
AWS_REGION=
AWS_KMS_KEY_ID=
VAULT_ADDR=
VAULT_TOKEN=

# AI (optional)
ANTHROPIC_API_KEY=
