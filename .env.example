# ============================================================================
# Education System — Environment Variables
# ============================================================================
#
# Copy to .env and fill in values. Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   python run.py
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
DEBUG=False
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json | text

# ── API Server ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false
API_SECRET_KEY=                      # Flask secret key (auto-generated if blank)
API_CORS_ORIGINS=                    # Comma-separated origins (blank = allow all with warning)
API_MAX_CONTENT_LENGTH=16777216      # Max request size in bytes (default 16MB)

# ── Authentication ──────────────────────────────────────────────────────
JWT_SECRET_KEY=                      # JWT signing secret (auto-generated if blank)
JWT_EXPIRY_HOURS=24                  # Access token lifetime
JWT_REFRESH_DAYS=7                   # Refresh token lifetime
EDU_SESSION_TIMEOUT=30               # Session timeout in minutes

# ── Database ────────────────────────────────────────────────────────────
# SQLite is used by default (zero config). Set these for PostgreSQL/MySQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=education_system
# DB_USER=
# DB_PASSWORD=

# ── Encryption ──────────────────────────────────────────────────────────
ENCRYPTION_KEY=                      # Fernet key for field-level encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SQLITE_ENCRYPTION_KEY=               # SQLCipher key for database encryption at rest
BACKUP_ENCRYPTION_KEY=               # Fernet key for backup encryption (falls back to ENCRYPTION_KEY)

# ── GDPR & Data Retention ──────────────────────────────────────────────
GDPR_RETENTION_YEARS=6               # Default retention period (UK education standard)

# ── Rate Limiting ───────────────────────────────────────────────────────
RATE_LIMIT_DB_PATH=                  # SQLite path for persistent rate limiting (blank = in-memory)

# ── Email / SMTP ────────────────────────────────────────────────────────
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=

# ── SMS (Twilio) ────────────────────────────────────────────────────────
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_FROM_NUMBER=

# ── Payment Processing ──────────────────────────────────────────────────
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ── LMS Integrations ───────────────────────────────────────────────────
# LMS_DB_PATH=                       # SQLite path for LMS sync state
# CANVAS_API_URL=
# CANVAS_API_TOKEN=
# MOODLE_API_URL=
# MOODLE_API_TOKEN=
# GOOGLE_CLASSROOM_CREDENTIALS=      # Path to service account JSON

# ── Microsoft Teams for Education ───────────────────────────────────────
# TEAMS_TENANT_ID=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=

# ── External APIs ───────────────────────────────────────────────────────
# EXCHANGE_API_KEY=                  # Currency exchange rates
# CLOUD_STORAGE_KEY=                 # Cloud storage provider

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# 1. Never commit .env with real values to version control
# 2. Use strong, randomly generated secrets (min 32 characters)
# 3. Rotate credentials regularly (at least every 90 days)
# 4. Use different credentials for dev/staging/production
# 5. Consider a secrets manager in production (Vault, AWS SM, Azure KV)
# 6. Set ENCRYPTION_KEY before first production deployment
# 7. Set API_CORS_ORIGINS to specific domains in production
# ============================================================================
