# ============================================================================
# Education System - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# ── Core Settings ────────────────────────────────────────────────────────────
# Default passwords for seeded user accounts (change in production!)
DEFAULT_ADMIN_PASSWORD=your_secure_password
DEFAULT_STAFF_PASSWORD=your_secure_password
DEFAULT_STUDENT_PASSWORD=your_secure_password

# ── Database Configuration ───────────────────────────────────────────────────
# Optional — defaults to SQLite files in each system's data/db_files/ directory
DB_HOST=localhost
DB_PORT=5432
DB_NAME=university_system
DB_USER=db_user
DB_PASSWORD=secure_password

# ── Email / SMTP Configuration ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# ── Application Settings ────────────────────────────────────────────────────
# Environment: development | staging | production
APP_ENV=development
# Enable debug mode (never enable in production)
DEBUG=True
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── API Server ───────────────────────────────────────────────────────────────
# Host and port for the unified Flask API server
API_HOST=0.0.0.0
API_PORT=5000
# Enable Flask debug mode (never enable in production)
API_DEBUG=false

# ── Authentication & Security ────────────────────────────────────────────────
# Secret key for signing JWT tokens; auto-generated at startup if not set
JWT_SECRET_KEY=
# Session timeout in minutes
EDU_SESSION_TIMEOUT=30

# ── Request Limits ───────────────────────────────────────────────────────────
# Maximum request body size in bytes (default: 16 MB)
API_MAX_CONTENT_LENGTH=16777216

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (empty = allow all with CSRF check)
API_CORS_ORIGINS=

# ── Secret Key ───────────────────────────────────────────────────────────────
# Flask SECRET_KEY for session cookies; auto-generated if not set
API_SECRET_KEY=
