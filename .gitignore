.mypy_cache/
.coverage
htmlcov/
.tox/
**/.pytest_cache/

# Claude
CLAUDE.md
.claude.json.backup*
**/.claude/

# Log files (runtime-generated)
# NOTE: Log directories are created by ensure_directories(); files are gitignored
*.log

# Database files and backups (runtime-generated, not committed)
# NOTE: DBs are created on first launch via seed_default_data() / initialise_database()
*.db
# SQLite WAL-mode sidecar files (transient; created/removed at runtime).
*.db-wal
*.db-shm
!education_system/shared/data/db_files/.gitkeep
education_system/university_system/data/db_files/
education_system/university_system/backups/
education_system/university_system/data/backups/
education_system/university_system/logs/
education_system/*/logs/*.db

# Compressed database backups (generated by backup_manager.py)
*.db.gz
*.db.enc
*.db.gz.enc
*.db.gz.meta.json
*.unencrypted.bak

# Generated reports, plots, uploads (runtime data)
education_system/*/data/reports/**/*.pdf
education_system/*/data/reports/**/*.csv
education_system/*/data/analytics/plots/*.png
education_system/*/data/uploads/**

# Runtime-written report templates (templates.json, quick_report_*.txt)
education_system/*/data/reports_templates/*
!education_system/*/data/reports_templates/.gitkeep

# User-saved backup templates (shipped seeds live in templates/backup_templates/)
education_system/*/data/backup_templates/*
!education_system/*/data/backup_templates/.gitkeep

# Activity logs (JSON, rotation files, enhanced logs)
education_system/*/logs/activity.*
education_system/*/logs/activity_log_*.json
education_system/*/logs/enhanced_log_*.json
education_system/*/logs/*.log.*

# Temporary files
education_system/*/data/temp/*
!education_system/*/data/temp/.gitkeep

# Mock artifacts from tests
"<MagicMock*"

# Stale export files in repo root
*.csv
import_history.json

# Export outputs
education_system/*/exports/

# Encryption keys
*.key
education_system/university_system/data/health_encryption.key
education_system/university_system/data/db_files/.encryption_master_key

# SMTP / email credentials (passwords must come from env vars)
**/email_config.json

# JWT secret files (persisted at first startup)
**/.jwt_secret

# Nginx TLS certificates
nginx/certs/

# Local-only artifacts
.academic_calendar/
TESTING*.docx
education_system/university_system/data/config/licenses.json
education_system/university_system/data/submissions/submitted/

# Local scratch directory — files dropped here for ad-hoc work, not for committing.
add/

# Per-instance runtime configs (defaults live in code; these files are written
# by the admin GUI and contain host paths and credential placeholders).
education_system/university_system/data/config/backup_config.json
education_system/university_system/data/config/overview_pins.json

# Generated audit dump
missing_tests.txt


# Local artifacts — not part of the project source
/education_system.zip
/.wget-hsts
/game/
education_system/*/data/*.db.backup_*

# Betting-shop arcade shared credit wallet (runtime state)
education_system/post_18/university_system/modules/domain/commerce/betting/gui/games/wallet.json
education_system/post_18/university_system/modules/domain/commerce/betting/gui/games/wallet_history.json

# --- Reorg (post_16/, post_18/) runtime + secret exclusions ---
# Encryption keys / secrets (never commit)
education_system/**/.keys/
education_system/**/.encryption_master_key

# Runtime logs, backups, and DB dumps under the new tree
education_system/**/logs/
education_system/**/backups/
education_system/**/*.db.backup_*
education_system/**/*.sql

# Vendored NLTK data (re-downloadable at runtime)
education_system/**/data/nltk_data/

# Generated report artifacts
education_system/**/data/reports/**/*.html
